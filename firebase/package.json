{
  "name": "harvesthub-firebase",
  "private": true,
  "type": "module",
  "engines": {"node": ">=20"},
  "scripts": {
    "emulators": "firebase emulators:start --config ../firebase.json --project demo-harvesthub",
    "test:rules": "firebase emulators:exec --config ../firebase.json --project demo-harvesthub --only auth,firestore,storage \"node --test test/rules.test.mjs\"",
    "test:seed": "firebase emulators:exec --config ../firebase.json --project demo-harvesthub --only auth,firestore \"node --test test/seed.test.mjs\"",
    "test:snapshot": "node --test test/snapshot.test.mjs",
    "seed:emulator": "node seed_snapshot.mjs --emulator",
    "seed:project": "node seed_snapshot.mjs"
  },
  "dependencies": {"firebase-admin": "^13.0.0"},
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.3",
    "firebase": "^10.14.1",
    "firebase-tools": "^13.35.1"
  }
}
